# TRACENET Root Environment Variables Example
# Copy to .env for local run or configure in Render Environment Settings

# Low RAM Optimization (Set to true on Render Free Tier to stay within 512MB RAM limit)
LOW_MEMORY_MODE=true

# Neo4j Database (Optional - falls back to NetworkX in-memory graph if offline)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=tracenet_secure_pass

# Model Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Server Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Frontend Production URL for CORS (Optional on Render, defaults to '*')
FRONTEND_URL=https://your-tracenet-frontend.vercel.app
